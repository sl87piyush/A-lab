{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@attemply/shared": [
        "../../packages/shared/src/index.ts"
      ]
    },
    "allowImportingTsExtensions": true,
    "types": [
      "jest",
      "react",
      "react-native",
      "node"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
