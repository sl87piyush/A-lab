{
  "expo": {
    "name": "Attemply Lab",
    "slug": "attemply-lab",
    "scheme": "attemply-lab",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.attemply.lab",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Photograph question sheets to build your own practice tests.",
        "NSPhotoLibraryUsageDescription": "Import question sheet photographs from your library."
      }
    },
    "android": {
      "package": "com.attemply.lab",
      "versionCode": 1,
      "permissions": [
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#172633"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Attemply Lab to photograph your question sheets.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose question photographs to create a test.",
          "cameraPermission": "Photograph question sheets.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#172633"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
