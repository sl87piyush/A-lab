{
  "name": "attemply-lab",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start -w @attemply/mobile",
    "api": "npm run dev -w @attemply/api",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck -w @attemply/mobile",
    "lint": "eslint .",
    "build:api": "npm run build -w @attemply/api",
    "test:mobile": "npm exec -w @attemply/mobile -- jest --runInBand"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "eslint": "^10.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-test-renderer": "19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "overrides": {
    "@mistralai/mistralai": {
      "zod": "^4.6.7"
    },
    "@modelcontextprotocol/sdk": {
      "zod": "^4.6.7"
    },
    "zod-to-json-schema": {
      "zod": "^4.6.7"
    }
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
